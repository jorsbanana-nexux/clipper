# CLIPPER - contoh konfigurasi. Salin file ini menjadi `.env`, lalu isi nilainya.
# ATAU cukup jalankan:  python setup.py   (akan membuat .env untukmu).

# WAJIB - key OpenAI untuk Whisper (transkripsi) + GPT (analisis momen viral).
OPENAI_API_KEY=

# OPSIONAL - token HuggingFace untuk multi-speaker (pyannote diarization).
# Kosong = OFF (single-speaker). Isi token = ON. setup.py: ketik "off" untuk mematikan.
HUGGINGFACE_TOKEN=

# Diatur otomatis oleh setup.py (1 = multi-speaker aktif). Tidak perlu diedit manual.
CLIPPER_MULTI_SPEAKER=
