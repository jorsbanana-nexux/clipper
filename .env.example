# CLIPPER - Konfigurasi (.env).
#
# CARA MANUAL (setup.py sudah dihapus):
#   1. Salin file ini:   copy .env.example .env
#   2. Mode GRATIS: isi GEMINI_API_KEY (dari aistudio.google.com/apikey) & kosongkan OPENAI_API_KEY
#      (transkripsi pakai faster-whisper lokal). Atau Mode OpenAI: isi OPENAI_API_KEY saja.
#   3. Install deps: pip install -r requirements.txt (+ -r requirements-free.txt untuk mode gratis)
#      lalu jalankan (lihat README "Menjalankan Secara Lokal")

# WAJIB - key OpenAI untuk Whisper (transkripsi) + GPT (analisis momen viral).
# Ambil di: https://platform.openai.com/api-keys
# NOTE: Jika pakai mode GRATIS (faster-whisper lokal + Gemini), baris ini boleh kosong.
OPENAI_API_KEY=

# === MODE GRATIS (tanpa biaya OpenAI) ===
# Transkripsi LOKAL di PC Anda (0 rupiah), word timestamps. Nilai: local / openai
WHISPER_BACKEND=local
# Ukuran model faster-whisper: small (default) / base / tiny (paling ringan)
WHISPER_MODEL_SIZE=small
# Analisis momen viral via Gemini (Google AI Studio) - gratis. Nilai: gemini / openai
ANALYSIS_BACKEND=gemini
# Kunci gratis dari https://aistudio.google.com/apikey (tanpa kartu)
GEMINI_API_KEY=
# Model Gemini untuk analisis (default flash, cepat & gratis).
# Penting: model lama gemini-2.x / 1.5 sudah dihapus Google (404).
# Pilihan valid saat ini: gemini-3.5-flash / gemini-3.6-flash / gemini-flash-latest
GEMINI_MODEL=gemini-3.5-flash

# OPSIONAL - token HuggingFace untuk multi-speaker (pyannote diarization).
# Ambil di: https://huggingface.co/settings/tokens
# Biarkan kosong = OFF (single-speaker, ringan). Isi token = ON.
# Catatan: token HF harus menerima lisensi model pyannote/speaker-diarization-3.1
HUGGINGFACE_TOKEN=

# Set "1" untuk mengaktifkan multi-speaker (HARUS bareng HUGGINGFACE_TOKEN).
# 0/kosong = single-speaker.
CLIPPER_MULTI_SPEAKER=

# OPSIONAL - tuning backend.
# Model OpenAI untuk analisis momen viral (structured output).
# Default: gpt-4o-mini. Ganti ke o-series bila ingin reasoning (mis. gpt-5).
ANALYSIS_MODEL=gpt-4o-mini

# OPSIONAL - hanya untuk model o-series yang mendukung reasoning effort.
# Kosong = parameter reasoning_effort TIDAK dikirim (aman untuk gpt-4o-mini).
# Isi mis. "low" / "medium" / "high" hanya bila ANALYSIS_MODEL = o-series.
ANALYSIS_REASONING=

# OPSIONAL - daftar origin CORS yang diizinkan (pisahkan dengan koma).
# Default aman untuk dev lokal (localhost:3000/8000). Untuk deploy publik,
# isi daftar origin frontend Anda secara eksplisit (bukan "*").
CLIPPER_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000
