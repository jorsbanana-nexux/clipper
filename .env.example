# CLIPPER - Konfigurasi (.env).
#
# CARA MANUAL (setup.py sudah dihapus):
#   1. Salin file ini:   copy .env.example .env
#   2. Mode GRATIS: isi GEMINI_API_KEY (dari aistudio.google.com/apikey) & kosongkan OPENAI_API_KEY
#      (transkripsi pakai faster-whisper lokal). Atau Mode OpenAI: isi OPENAI_API_KEY saja.
#   3. Install deps: pip install -r requirements.txt (+ -r requirements-free.txt untuk mode gratis)
#      lalu jalankan (lihat README "Menjalankan Secara Lokal")

# WAJIB - key OpenAI untuk Whisper (transkripsi) + GPT (analisis momen viral).
# Ambil di: https://platform.openai.com/api-keys
# NOTE: Jika pakai mode GRATIS (faster-whisper lokal + Gemini), baris ini boleh kosong.
OPENAI_API_KEY=

# === MODE GRATIS (tanpa biaya OpenAI) ===
# Transkripsi LOKAL di PC Anda (0 rupiah), word timestamps. Nilai: local / openai
WHISPER_BACKEND=local
# Ukuran model faster-whisper: small (default) / base / tiny (paling ringan)
WHISPER_MODEL_SIZE=small
# KECEPATAN: berapa clip dirender bersamaan (memakai beberapa inti CPU).
#  3 (default) = 3 clip paralel -> 4 clip jauh lebih cepat. Naikkan ke 4-6 untuk
#  banyak clip; TURUNKAN ke 1-2 bila RAM 8GB terasa berat/pelan.
CLIPPER_MAX_PARALLEL=3
# Strategi potong clip: accurate (persis detik, re-encode) / fast (stream copy,
#  jauh lebih cepat, batas mengikuti keyframe ~2-5s).
CLIPPER_CUT_MODE=fast
# Analisis momen viral via Gemini (Google AI Studio) - gratis. Nilai: gemini / openai
ANALYSIS_BACKEND=gemini
# Kunci gratis dari https://aistudio.google.com/apikey (tanpa kartu)
GEMINI_API_KEY=
# Model Gemini untuk analisis momen viral (kualitas tinggi & GRATIS).
# Penting: model lama gemini-2.x / 1.5 sudah dihapus Google (404).
# Rekomendasi: gemini-3.8-flash = Flash PALING CERDAS utk analisis kompleks (gratis).
# Alternatif berkualitas lebih tinggi: gemini-2.5-pro (reasoning lebih dalam,
# gratis di free tier, tapi batas request/hari lebih ketat & lebih lambat).
# Fallback lain: gemini-3.7-flash / gemini-3.6-flash.
GEMINI_MODEL=gemini-3.8-flash
# Auto-retry saat Gemini sibuk (503 high demand / 429). Naikkan jika sering 503.
GEMINI_RETRIES=4
# v0.3.1: FALLBACK MODEL — jika model utama 404/dipensiunkan/sibuk, otomatis
# coba model berikutnya (semua gratis di AI Studio). Dipisah koma.
GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-2.5-pro
# v0.3.1: QUALITY GATE — clip dengan skor viral di bawah nilai ini DIBUANG
# (anti konten asal/basih). Tidak pernah mengosongkan hasil.
CLIPPER_MIN_VIRAL_SCORE=4

# OPSIONAL - token HuggingFace untuk multi-speaker (pyannote diarization).
# Ambil di: https://huggingface.co/settings/tokens
# Biarkan kosong = OFF (single-speaker, ringan). Isi token = ON.
# Catatan: token HF harus menerima lisensi model pyannote/speaker-diarization-3.1
HUGGINGFACE_TOKEN=

# === SEMANTIK SPLIT-SCREEN DUO (v0.3.1) — PENTING DIBACA ===
# HF AKTIF  (CLIPPER_MULTI_SPEAKER=1 + HUGGINGFACE_TOKEN + `pip install -r
#            requirements-multispeaker.txt`) -> split-screen duo ON OTOMATIS:
#            layar terbelah atas-bawah 2,5s SEBELUM pembicara ke-2 bicara
#            (anti-telat), menutup saat 1 pembicara monolog, buka lagi saat
#            ada giliran bicara. Jendela yang ternyata cuma 1 wajah otomatis
#            di-downgrade ke solo (tidak ada setengah layar kosong).
# HF NONAKTIF -> SOLO crop-follow mulus, mengikuti pembicara aktif, TANPA
#            split-screen. (Auto-duo tanpa HF kini default OFF, lihat bawah.)
# Set "1" untuk mengaktifkan multi-speaker (HARUS bareng HUGGINGFACE_TOKEN).
# 0/kosong = single-speaker.
CLIPPER_MULTI_SPEAKER=


# OPSIONAL - tuning backend.
# Model OpenAI untuk analisis momen viral (structured output).
# Default: gpt-4o-mini. Ganti ke o-series bila ingin reasoning (mis. gpt-5).
ANALYSIS_MODEL=gpt-4o-mini

# OPSIONAL - hanya untuk model o-series yang mendukung reasoning effort.
# Kosong = parameter reasoning_effort TIDAK dikirim (aman untuk gpt-4o-mini).
# Isi mis. "low" / "medium" / "high" hanya bila ANALYSIS_MODEL = o-series.
ANALYSIS_REASONING=

# OPSIONAL - daftar origin CORS yang diizinkan (pisahkan dengan koma).
# Default aman untuk dev lokal (localhost:3000/8000). Untuk deploy publik,
# isi daftar origin frontend Anda secara eksplisit (bukan "*").
CLIPPER_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000

# === Subtitle preset "mrbeast" (v0.3.4: env ini kini BENAR2 DIPAKAI) ===
# BUGFIX PENTING: sebelum v0.3.4, preset "mrbeast" di config.py hardcode
# literal -- semua CLIPPER_SUBTITLE_* di bawah ini DIAM-DIAM DIABAIKAN, tak
# peduli apa isinya. Sekarang preset "mrbeast" (gaya default/flagship)
# benar2 membaca nilai-nilai ini. Default di bawah = hasil replikasi
# frame-by-frame video referensi youtube.com/watch?v=pf9vd2sny0M (MrBeast
# subtitle tutorial): biru elektrik #00E5FF, Komika Axis, size besar.
# Preset LAIN (hormozi/karaoke/minimal) TETAP art-directed hardcode di
# config.py -- env ini HANYA memengaruhi preset "mrbeast".
CLIPPER_SUBTITLE_LINES=2          # maks baris subtitle (2 = aman utk vertikal)
CLIPPER_SUBTITLE_SIZE=150         # ukuran font (besar, Mr Beast style, replikasi video referensi)
CLIPPER_SUBTITLE_POP_COLOR=&H00FFE500   # kata aktif = BIRU ELEKTRIK STABILO (ASS=&HAABBGGRR, #00E5FF persis video referensi)
CLIPPER_SUBTITLE_BASE_COLOR=&H00FFFFFF  # kata belum diucapkan = PUTIH
CLIPPER_SUBTITLE_OUTLINE=12       # outline hitam tebal (terbaca di atas wajah/latar ramai)
CLIPPER_SUBTITLE_SHADOW=2
CLIPPER_SUBTITLE_BACK_COLOR=&H70141014  # kotak semi-transparan
CLIPPER_SUBTITLE_POP=1.20         # scale BOUNCE kata aktif (membesar lalu kembali; 1.0 = mati)
CLIPPER_SUBTITLE_FONT=Komika Axis      # font resmi Mr Beast (auto-bundle dari repo/fonts)
CLIPPER_SUBTITLE_WORDS=2          # ~2 kata per cue (Mr Beast style)
CLIPPER_SUBTITLE_MIN_DUR=0.9      # min durasi cue (anti ngebut/kacau saat bicara cepat)
CLIPPER_SUBTITLE_WORDS_OVERFLOW=5 # maks kata saat bicara cepat (agar tak terlalu panjang)

# Kamera / face tracking: zoom-out & kehalusan pan.
CLIPPER_FACE_ZOOM=0.86            # <1.0 = zoom-out (wajah lebih kecil, ada headroom)
CLIPPER_FACE_SMOOTH=0.28          # alpha EMA pan (lebih rendah = lebih halus)
CLIPPER_FACE_HEADROOM=0.30        # posisi subjek dari atas (0..0.5)

# Split-screen duo: LEAD (belahan sebelum pembicara ke-2) + fallback AUTO tanpa token.
CLIPPER_DUO_LEAD_SEC=2.5          # sudah otomatis "seluruh clip duo" bila >=2 pembicara
# Auto-duo TANPA HuggingFace (deteksi 2 wajah). v0.3.1: default 0 = OFF.
# Sesuai spesifikasi: HF off = solo murni. Set 1 HANYA jika Anda memang
# menginginkan split-screen tanpa diarization (fallback gratis).
CLIPPER_DUO_AUTO_FACES=0
CLIPPER_DUO_AUTO_FACE_RATIO=0.35  # minimal proporsi frame ber-2 wajah
CLIPPER_DUO_FACE_RATIO=0.4        # duo dipakai hanya jika >=40% sampel di jendela itu punya 2 wajah
                                  # (cegah split kosong saat kamera potong close-up)

# Akurasi potongan: trim presisi + ekor pendek agar clip berhenti tepat di poin.
CLIPPER_PRECISE_TRIM=1            # 1 = potong tepat [awal,akhir], tidak melewati poin
CLIPPER_TAIL_SEC=0.35             # jeda setelah punchline (kecil = clip berhenti tegas)

# === BATCH / PERFORMA RENDER ===
# Render 10-100 klip cepat & stabil tanpa crash. Default CPU-aware.
CLIPPER_MAX_PARALLEL=             # biarkan kosong utk auto (min(8, cpu//2)); set 1 utk laptop lemah / 8 utk desktop
CLIPPER_FFMPEG_PRESET=veryfast    # veryfast ~2-3x lebih cepat dari fast, kualitas hampir sama
CLIPPER_FFMPEG_CRF=21             # quality/size (lebih rendah = lebih bagus, file lebih besar)
CLIPPER_FONT_DIR=                 # default otomatis pakai <repo>/fonts (sudah ada Komika Axis)

# ==================== v0.4 — SUPERCLIP (visual & offline) ====================
# Mode analisis: gemini / openai / local.
#  - gemini/openai: pakai API key di atas (kualitas terbaik).
#  - local        : 100% OFFLINE, nol API key, nol biaya (heuristic analyzer).
#  - Tanpa key sama sekali? Backend otomatis pakai 'local' — job TETAP jalan.
ANALYSIS_BACKEND=gemini
# Hook title overlay (headline besar ~3.5s pertama tiap clip). 1 = ON.
CLIPPER_HOOK_TEXT=1
# Progress bar animasi di tepi atas. 1 = ON.
CLIPPER_PROGRESS_BAR=1
# Loudness normalization ke -14 LUFS (standar TikTok/Shorts/Reels). 1 = ON.
CLIPPER_LOUDNORM=1
# Emoji captions ala Submagic. Default 0: butuh font emoji di sistem (mis.
# Noto Color Emoji); tanpa itu libass menggambar kotak kosong.
CLIPPER_EMOJI=0
