# CLIPPER - Template konfigurasi.
#
# Cara termudah: jalankan  python setup.py  (otomatis buat .venv + install deps).
#
# Cara manual:
#   1. Salin file ini:   copy .env.example .env
#   2. Isi OPENAI_API_KEY di bawah
#   3. Backend:   .venv\Scripts\python backend\run.py
#   4. Frontend:  cd frontend && npm run dev

# WAJIB - key OpenAI untuk Whisper (transkripsi) + GPT (analisis momen viral).
OPENAI_API_KEY=

# OPSIONAL - token HuggingFace untuk multi-speaker (pyannote diarization).
# Kosong = OFF (single-speaker, ringan). Isi token = ON.
# Di setup.py: ketik "off" untuk mematikan.
HUGGINGFACE_TOKEN=

# Diatur otomatis oleh setup.py. Jangan edit manual.
CLIPPER_MULTI_SPEAKER=
